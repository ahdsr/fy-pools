# Required for Supabase auth/session clients and server-side pool mutations.
# For local Supabase, use http://127.0.0.1:54321 and its anon key from `npx supabase status`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required only when using the local Supabase CLI stack with Google OAuth.
# These are Google OAuth web-client credentials; never commit the client secret.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Required only for trusted scoring refresh calls to the Round of 16 score API.
FY_POOLS_SCORING_API_KEY=

# Required in production: protects the scheduled World Cup result refresh.
CRON_SECRET=

# Optional deployment/runtime settings.
NEXT_PUBLIC_BASE_PATH=
FY_POOLS_LOCAL_RESULTS_JOB=
FY_POOLS_LOCAL_RESULTS_REFRESH_MS=
FY_POOLS_FIFA_REQUEST_TIMEOUT_MS=
FY_POOLS_FIFA_BONUS_CACHE_MS=
FY_POOLS_FIFA_BONUS_WARM_TIMEOUT_MS=
FY_POOLS_RESULTS_STALE_MS=

# Reserved for later launch scope; not required by the Round of 16 MVP.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
FY_POOLS_EMAIL_FROM=
# Sends the current test recipient a message when a player newly reaches rank 1.
FY_POOLS_LEADER_NOTIFICATION_TEST_EMAIL=
